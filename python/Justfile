# list the available rules
default:
	just --list

# build the project
build:
	uv build

# install the lint/test dependencies
sync:
	uv sync --group lint --group test

# check the code
check:
	uv run ruff format --check
	uv run ruff check
	uv run mypy

# format the code
fmt *files=".":
	uv run ruff format

# format and lint the code
lint: fmt
	uv run ruff check --fix .

# run the tests
test *files=".":
	uv run pytest {{files}}
